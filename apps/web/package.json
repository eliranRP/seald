{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0 && node scripts/check-component-coverage.mjs",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "bdd:gen": "bddgen",
    "bdd": "bddgen && playwright test",
    "bdd:smoke": "bddgen && playwright test --grep @smoke",
    "bdd:full": "bddgen && playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes --build-script-name=build-storybook"
  },
  "dependencies": {
    "@sentry/react": "^10.76.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "i18next": "^26.5.11",
    "jspdf": "^4.2.1",
    "lucide-react": "1.63.0",
    "pdf-lib": "^1.17",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5",
    "shared": "workspace:*",
    "styled-components": "6.6.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-themes": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.7.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.12",
    "chromatic": "^16",
    "eslint": "9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.4",
    "globals": "^17.13.0",
    "jsdom": "25.0.1",
    "playwright-bdd": "^8",
    "rollup-plugin-visualizer": "^7.1.1",
    "storybook": "10.6.4",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vitest-axe": "0.1.0"
  }
}
