{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "Seald backend API",
  "scripts": {
    "build": "nest build",
    "build:edge": "node scripts/build-edge.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0 --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json",
    "test:mutation": "stryker run",
    "storage:init": "node scripts/ensure-storage-bucket.mjs",
    "smoke:upload": "node scripts/smoke-upload.mjs",
    "seed:signer": "ts-node --transpile-only scripts/seed-signer.ts",
    "flush:emails": "ts-node --transpile-only scripts/flush-emails.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/throttler": "^6.7.1",
    "@react-pdf/renderer": "^4.5.1",
    "@signpdf/placeholder-plain": "^4",
    "@signpdf/signer-p12": "^4",
    "@signpdf/signpdf": "^4",
    "@signpdf/utils": "^4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "jpeg-js": "^0.4.4",
    "kysely": "^0.29.8",
    "multer": "^2.5.0",
    "node-forge": "1.4.3",
    "pdf-lib": "^1.17",
    "pg": "^8.23.1",
    "pngjs": "^7",
    "qrcode": "^1.5",
    "react": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "26.6.6",
    "@types/node-forge": "^1.3",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/supertest": "^7.2.1",
    "canvas": "^3.2.3",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pdfjs-dist": "6.5.438",
    "pg-mem": "^3.0.14",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
