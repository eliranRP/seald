{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "description": "Seald backend API",
  "scripts": {
    "build": "nest build",
    "build:edge": "node scripts/build-edge.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0 --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:mutation": "stryker run",
    "storage:init": "node scripts/ensure-storage-bucket.mjs",
    "smoke:upload": "node scripts/smoke-upload.mjs",
    "seed:signer": "ts-node --transpile-only scripts/seed-signer.ts",
    "flush:emails": "ts-node --transpile-only scripts/flush-emails.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/throttler": "^6.7.1",
    "@react-pdf/renderer": "^4.9.0",
    "@signpdf/placeholder-plain": "^3",
    "@signpdf/signer-p12": "^3",
    "@signpdf/signpdf": "^3",
    "@signpdf/utils": "^3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "jpeg-js": "^0.4.4",
    "kysely": "^0.29.7",
    "multer": "^2.5.0",
    "node-forge": "1.4.0",
    "pdf-lib": "^1.17",
    "pg": "^8.23.1",
    "pngjs": "^7",
    "qrcode": "^1.5",
    "react": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@faker-js/faker": "^10.5.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.21",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "20.16.10",
    "@types/node-forge": "^1.3",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "canvas": "^3.2.3",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "jest": "^30.4.2",
    "pdfjs-dist": "6.3.289",
    "pg-mem": "^3.0.14",
    "sharp": "^0.35.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3"
  }
}
