---
// BaseLayout.astro — shared <head> + <body> shell for every marketing page.
//
// Responsibilities:
//   - SEO meta (title, description, canonical, robots)
//   - Open Graph + Twitter Card
//   - JSON-LD (Organization + WebSite + SoftwareApplication)
//   - Favicon + apple-touch-icon + webmanifest
//   - Cloudflare Web Analytics beacon (token left empty — see CLAUDE.md)
//   - Global stylesheet
//
// Pages should compose this layout, set `title`/`description`/`canonical`
// via props, then drop their content in the <slot/>.

import '@/styles/globals.css';
import { toPublicPath } from '@/public-path.js';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * When `true` (the default for everything except the marketing homepage)
   * the layout renders a small shared footer with the legal links + the
   * "Manage cookie preferences" button. The homepage opts out via
   * `minimalFooter={false}` because it ships its own full marketing footer
   * that already includes the same controls — rendering both would
   * duplicate the cookie-management entry point.
   *
   * Issue #39 / EDPB 03/2022 + CCPA §7026(a)(4): consent withdrawal MUST
   * be reachable from every surface, with the same ease as giving it.
   */
  minimalFooter?: boolean;
}

const {
  title = 'Seald — Put your name to it.',
  description = 'Seald is a quieter way to sign, send, and store documents — built for the contracts you actually care about. PAdES digital seals with an RFC 3161 timestamp when a timestamp authority is reachable, plus a separate audit PDF.',
  canonical,
  // Default OG image is a 1200×630 PNG. Facebook, LinkedIn, Slack,
  // iMessage and most Twitter ingest pipelines reject SVG, so we ship
  // a PNG generated from /og-image.svg at build time. Audit E ·
  // BaseLayout H (OG image is SVG — rejected by most platforms).
  ogImage = '/og-image.png',
  noindex = false,
  minimalFooter = true,
} = Astro.props;

// Resolve canonical against the configured site so relative paths work.
// Fallback explicitly to the production canonical hostname per CLAUDE.md
// — every canonical URL, OG URL, and JSON-LD `url` must point at the
// real public host. Audit E · BaseLayout M (Astro.site fallback wrong).
const siteUrl = Astro.site ?? new URL('https://seald.nromomentum.com');

const publicPath = toPublicPath(
  canonical ? new URL(canonical, siteUrl).pathname : Astro.url.pathname,
);
const canonicalUrl = new URL(publicPath, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();
const origin = siteUrl.origin;
const homeUrl = `${origin}/`;
const organizationId = `${origin}/#organization`;
const websiteId = `${origin}/#website`;
const softwareId = `${origin}/#software`;

// One stable graph on every page. Descriptions do not change with the
// page. The public name is the Seald brand. A registered legal name,
// postal address, social profiles, and price offers stay out until published.
const organizationDescription =
  'Seald is a web application for preparing, signing, and sealing PDF documents.';
const softwareDescription =
  'Seald is a browser-based e-signature application. Upload a PDF, collect signatures, and download a file with a PAdES seal when a seal is applied, an RFC 3161 timestamp when available, and a SHA-256 audit chain.';

const organizationLd = {
  '@type': 'Organization',
  '@id': organizationId,
  name: 'Seald',
  url: homeUrl,
  logo: new URL('/icon-512.png', siteUrl).toString(),
  description: organizationDescription,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'support@seald.nromomentum.com',
    url: new URL('/contact', siteUrl).toString(),
    availableLanguage: ['en'],
  },
};

const websiteLd = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: 'Seald',
  url: homeUrl,
  inLanguage: 'en',
  publisher: { '@id': organizationId },
};

const softwareLd = {
  '@type': 'SoftwareApplication',
  '@id': softwareId,
  name: 'Seald',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: softwareDescription,
  featureList: [
    'Sign a PDF yourself in the browser',
    'Request signatures from other people, all invited at the same time',
    'Reusable templates that keep fields and signers',
    'Type, draw, or upload a signature',
    'PAdES seal (when a seal is applied)',
    'RFC 3161 timestamp (when available)',
    'SHA-256 audit chain',
    'Public verification of a sealed document',
  ],
  url: homeUrl,
  publisher: { '@id': organizationId },
};

const breadcrumbLd = publicPath.startsWith('/legal/')
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${origin}${publicPath}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: homeUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: title.replace(/\s+[—–-]\s+Seald$/, ''),
          item: canonicalUrl,
        },
      ],
    }
  : null;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [organizationLd, websiteLd, softwareLd, ...(breadcrumbLd ? [breadcrumbLd] : [])],
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="google-site-verification" content="H_Xstu_43x0SSxeQggMkWFsRP9NaQEWEYwXau19TwaA" />

    <!-- Theme -->
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Seald" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image:alt" content="Seald, a web app for e-signatures" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:url" content={canonicalUrl} />

    <!-- Favicon + manifest. favicon.ico is a real multi-size icon
         generated from favicon.svg (16, 32, 48). -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Sitemap discovery. The index lives at /sitemap.xml (see robots.txt). -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- JSON-LD: one @graph. Organization is stable across pages. -->
    <script type="application/ld+json" set:html={jsonLd} />

    <!--
      Cookie consent (T-30, /legal/cookies §4).
      ----------------------------------------
      The consent script is shared between the Astro landing and the
      React SPA — both live on seald.nromomentum.com. It shows the
      banner on first visit, persists the choice in `seald_consent_v1`
      (12-month, EDPB 03/2022), honors Global Privacy Control, and only
      injects the Cloudflare Web Analytics beacon after explicit consent.

      To enable analytics in production, drop the real beacon token into
      the meta tag below. With an empty token, no beacon is loaded even
      after consent — fail-closed.
    -->
    <meta name="cf-beacon-token" content="" />
    <script defer src="/scripts/cookie-consent.js"></script>

    <!--
      .reveal elements start at opacity:0 and rely on IntersectionObserver
      in /scripts/landing.js to add `.in` and fade them in. If JS is
      disabled (CSP block, slow network, no-JS browsers), every section
      of the homepage stays invisible. Force them visible when JS is off.
      Audit E · index.astro H (.reveal{opacity:0} leaves page invisible).
    -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>

  <body>
    <a href="#main" class="sr-only">Skip to main content</a>
    <slot />
    {minimalFooter ? (
      <footer class="minimal-footer" aria-label="Legal and cookie preferences">
        <div class="container">
          <nav class="minimal-footer-links" aria-label="Legal links">
            <a href="/legal/privacy">Privacy</a>
            <a href="/legal/terms">Terms</a>
            <a href="/legal/cookies">Cookies</a>
            <a href="/legal/accessibility">Accessibility</a>
            <a href="/legal/responsible-disclosure">Report a vulnerability</a>
            <button
              type="button"
              class="link-button"
              data-testid="footer-manage-cookies"
              data-action="open-cookie-banner"
            >
              Manage cookie preferences
            </button>
          </nav>
          <p class="minimal-footer-copy">© 2026 Seald, Inc. — Put your name to it.</p>
        </div>
      </footer>
    ) : null}
  </body>
</html>
